# Keep local mode as the safe default. V0.4 data continues to work without a backend.
VITE_BACKEND_PROVIDER=local

# CloudBase PG (recommended primary backend for the mainland-China deployment).
VITE_CLOUDBASE_ENV_ID=
VITE_CLOUDBASE_PUBLISHABLE_KEY=
VITE_CLOUDBASE_REGION=ap-shanghai

# Optional Supabase adapter. These values are intentionally unused unless the
# provider is explicitly changed to "supabase".
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
