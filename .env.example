# Select one canonical backend for each deployment. Local remains the safe default.
# Never configure Supabase and CloudBase as separate writable stores for the same couple.
VITE_BACKEND_PROVIDER=local

# Overseas baseline: Vercel + Supabase. Only the browser-safe publishable key belongs here.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Set both when CAPTCHA protection is enabled in Supabase Auth. The Site Key is public; the Secret Key stays in Supabase.
VITE_SUPABASE_CAPTCHA_PROVIDER=
VITE_SUPABASE_CAPTCHA_SITE_KEY=

# Mainland Alpha 3: CloudBase PG Auth/PostgreSQL. Use the Publishable Key only.
# Never put a Secret Key, server key, or administrator credential in any VITE_* variable.
VITE_CLOUDBASE_ENV_ID=
VITE_CLOUDBASE_PUBLISHABLE_KEY=
VITE_CLOUDBASE_REGION=ap-shanghai
